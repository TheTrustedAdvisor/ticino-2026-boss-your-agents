# Copy to config.env (never commit config.env) and fill in. stage.sh reads it.
# Two EMPTY workspaces on a Fabric capacity. The agents never create workspaces.
WORKSPACE_1_ID=<workspace-1-id>
WORKSPACE_1_NAME="Sales Session 1 DEV"
WORKSPACE_2_ID=<workspace-2-id>
WORKSPACE_2_NAME="Sales Session 2 DEV"

# Two identities of your tenant, never your own account:
#   builder   Contributor in both workspaces (builds)
#   reviewer  Contributor in both workspaces (getDefinition needs write; the session keeps it read-only)
# plus a third, the viewer, that is only an RLS role member (put its UPN into data/ with make_data.py).
BUILDER_UPN=builder@contoso.example
REVIEWER_UPN=reviewer@contoso.example

# A shell command that prints an access token for the resource in $RESOURCE, as that identity.
# One Azure CLI login per identity (az login --allow-no-subscriptions --tenant <tenant-id>, once per config dir).
# Name the tenant explicitly. Never put a password or secret into these lines: agents can read .lab-env.
TOKEN_CMD_BUILDER='AZURE_CONFIG_DIR=$HOME/.azure-builder az account get-access-token --tenant <tenant-id> --resource "$RESOURCE" --query accessToken -o tsv'
TOKEN_CMD_REVIEWER='AZURE_CONFIG_DIR=$HOME/.azure-reviewer az account get-access-token --tenant <tenant-id> --resource "$RESOURCE" --query accessToken -o tsv'

# Who signs the baseline and owns the decisions (snapshot.py sign, /decide)
APPROVED_BY="Your Name"
# Python with pyarrow and pyyaml (optional; default python3)
# PY=$HOME/.venvs/boss-your-agents/bin/python
